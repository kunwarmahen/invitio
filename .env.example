# ═══════════════════════════════════════════════════════════════
# invitio — Environment Configuration
# Copy to .env and fill in. `./deploy.sh local up` auto-copies if missing.
# ═══════════════════════════════════════════════════════════════

# ─── Debug ────────────────────────────────────────────────────
DEBUG=0

# ─── Auth ─────────────────────────────────────────────────────
# Generate a strong one:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Database ─────────────────────────────────────────────────
# Local dev (default): SQLite. The compose files set these for you, so you
# usually don't need to touch them here.
DATABASE_PROVIDER=sqlite
DATABASE_URL=sqlite+aiosqlite:///./invitio.db

# Production (NAS) uses PostgreSQL. docker-compose.nas.yml builds the URL from
# POSTGRES_PASSWORD, so just set the password here:
POSTGRES_PASSWORD=change-me-strong-password

# ─── Public URL ───────────────────────────────────────────────
# Absolute base URL of the deployment. Used to build the RSVP links that go in
# invitation emails — must be reachable by your guests.
#   local:  http://localhost:8080
#   NAS:    https://invite.mahensingh.ddns.info
PUBLIC_BASE_URL=http://localhost:8080

# CORS allow-list (JSON array). Match your PUBLIC_BASE_URL.
ALLOWED_ORIGINS=["http://localhost:8080"]

# ─── Uploads ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ─── Email (optional) ─────────────────────────────────────────
# Enables emailing RSVP links to guests. Leave GMAIL_APP_PASSWORD blank to
# disable sending — the app still generates shareable/personal links to copy.
# Create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=invitio

# ─── Reminders (optional) ─────────────────────────────────────
# A background loop (only runs when email above is configured) emails a reminder
# to "yes" guests and a nudge to non-responders before each event. Each event is
# reminded once. Set REMINDERS_ENABLED=false to turn it off.
REMINDERS_ENABLED=true
REMINDER_WINDOW_HOURS=24
REMINDER_CHECK_INTERVAL_MINUTES=60

# ─── AI generation (optional) ─────────────────────────────────
# Help hosts write invite copy / broadcasts and generate a hero image. Both are
# OFF by default and configured independently. Any OpenAI-compatible endpoint
# works (local or hosted) — only the base URL / key / model change.
#
# Text (LLM): an OpenAI-compatible /v1/chat/completions endpoint.
#   Ollama:    http://localhost:11434/v1   (model e.g. llama3.1, qwen2.5)
#   llama.cpp: http://localhost:8080/v1    (llama-server)
#   Set AI_LLM_API_KEY only for hosted providers (leave blank for local).
AI_LLM_ENABLED=false
AI_LLM_BASE_URL=http://localhost:11434/v1
AI_LLM_API_KEY=
AI_LLM_MODEL=llama3.1
AI_LLM_TIMEOUT=60
#
# Images: an OpenAI-compatible /v1/images/generations endpoint (e.g. LocalAI).
#   For an RTX 3090 (24 GB): SDXL 1.0 (reliable default), SDXL-Turbo (fast),
#   or FLUX.1-schnell (4-step, fp8/Q8) for higher quality.
AI_IMAGE_ENABLED=false
AI_IMAGE_BASE_URL=http://localhost:8080/v1
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=sdxl
AI_IMAGE_SIZE=1024x1024
AI_IMAGE_TIMEOUT=180
