# ═══════════════════════════════════════════════════════════════
# invitio — Environment Configuration
# Copy to .env and fill in. `./deploy.sh local up` auto-copies if missing.
# ═══════════════════════════════════════════════════════════════

# ─── Debug ────────────────────────────────────────────────────
DEBUG=0

# ─── Auth ─────────────────────────────────────────────────────
# Generate a strong one:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Database ─────────────────────────────────────────────────
# Local dev (default): SQLite. The compose files set these for you, so you
# usually don't need to touch them here.
DATABASE_PROVIDER=sqlite
DATABASE_URL=sqlite+aiosqlite:///./invitio.db

# Production (NAS) uses PostgreSQL. `./deploy.sh nas deploy` asks whether to
# bundle a NEW postgres container or REUSE an existing instance:
#   • NEW (default): docker-compose.nas.yml builds the URL from POSTGRES_PASSWORD,
#     so you only need to set the password below.
#   • EXISTING: deploy.sh prompts for the connection details and writes the full
#     DATABASE_URL into the deployed .env for you — POSTGRES_PASSWORD is ignored,
#     and your local .env here is left untouched.
POSTGRES_PASSWORD=change-me-strong-password

# ─── Public URL ───────────────────────────────────────────────
# Absolute base URL of the deployment. Used to build the RSVP links that go in
# invitation emails — must be reachable by your guests.
#   local:  http://localhost:8080
#   NAS:    https://invite.mahensingh.ddns.info
PUBLIC_BASE_URL=http://localhost:8080

# CORS allow-list (JSON array). Match your PUBLIC_BASE_URL.
ALLOWED_ORIGINS=["http://localhost:8080"]

# ─── NAS nginx port (production only) ──────────────────────────
# Host port the NAS nginx binds on 127.0.0.1 for the Asustor reverse proxy to
# forward to. Defaults to 18080; change it when another app's nginx already uses
# 18080 (e.g. calorieapp), then point invitio's reverse-proxy rule at the new
# port. `./deploy.sh nas deploy` also accepts NAS_HTTP_PORT to set this for you.
# INVITIO_HTTP_PORT=18081

# ─── Uploads ──────────────────────────────────────────────────
# Uploads are validated by their real bytes (not the Content-Type), downsized,
# recompressed, and thumbnailed via Pillow. MAX_UPLOAD_MB caps the *raw* upload.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ─── No-account "quick create" ────────────────────────────────
# Lets anyone create one event without signing up (the /quick page + the
# "create without an account" link on the sign-in screen). Set to false to
# require an account — the page redirects home, the API returns 403, and the
# link is hidden. Existing quick events keep working via their manage link.
QUICK_CREATE_ENABLED=true

# ─── Anti-abuse rate limiting ─────────────────────────────────
# Per-client-IP, fixed 1-hour window, in-memory (single-instance). Protects the
# open no-account flows. Set RATE_LIMIT_ENABLED=false to disable, or set an
# individual limit to 0 to disable just that bucket.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CREATE_PER_HOUR=10
RATE_LIMIT_RSVP_PER_HOUR=60
RATE_LIMIT_VIEW_PER_HOUR=240
RATE_LIMIT_WALL_PER_HOUR=30
RATE_LIMIT_AUTH_PER_HOUR=30

# Page size for the dashboard guest-list / RSVP lists. The event detail embeds at
# most this many of each; the rest load on demand from /invites and /rsvps.
LIST_PAGE_SIZE=50

# ─── Email (optional) ─────────────────────────────────────────
# Enables emailing RSVP links to guests. Leave GMAIL_APP_PASSWORD blank to
# disable sending — the app still generates shareable/personal links to copy.
# Create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=invitio

# ─── Reminders (optional) ─────────────────────────────────────
# A background loop (only runs when email above is configured) emails a reminder
# to "yes" guests and a nudge to non-responders before each event. Each event is
# reminded once. Set REMINDERS_ENABLED=false to turn it off.
REMINDERS_ENABLED=true
REMINDER_WINDOW_HOURS=24
REMINDER_CHECK_INTERVAL_MINUTES=60

# ─── AI generation (optional) ─────────────────────────────────
# Help hosts write invite copy / broadcasts and generate a hero image. Both are
# OFF by default and configured independently. Any OpenAI-compatible endpoint
# works (local or hosted) — only the base URL / key / model change.
#
# Text (LLM): an OpenAI-compatible /v1/chat/completions endpoint.
#   Ollama:    http://localhost:11434/v1   (model e.g. llama3.1, qwen2.5)
#   llama.cpp: http://localhost:8080/v1    (llama-server)
#   Set AI_LLM_API_KEY only for hosted providers (leave blank for local).
AI_LLM_ENABLED=false
AI_LLM_BASE_URL=http://localhost:11434/v1
AI_LLM_API_KEY=
AI_LLM_MODEL=llama3.1
AI_LLM_TIMEOUT=60
#   The LLM often runs on a separate machine. The frontend probes its reachability
#   (via /api/ai/status) and disables the "Generate" buttons when it's down, asking
#   the host to write manually. This is the short timeout for that probe.
AI_LLM_HEALTH_TIMEOUT=5
#
# Images: an OpenAI-compatible /v1/images/generations endpoint (e.g. LocalAI).
#   For an RTX 3090 (24 GB): SDXL 1.0 (reliable default), SDXL-Turbo (fast),
#   or FLUX.1-schnell (4-step, fp8/Q8) for higher quality.
AI_IMAGE_ENABLED=false
AI_IMAGE_BASE_URL=http://localhost:8080/v1
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=sdxl
AI_IMAGE_SIZE=1024x1024
AI_IMAGE_TIMEOUT=180
